---
// Carte schématique : projection plane autour du siège, 10 px par kilomètre.
interface Ville { nom: string; latitude: number; longitude: number; type: 'siege' | 'etablissement' | 'chantier'; etiquetteAGauche: boolean }
interface Props { villes: Ville[]; legende: string }
const { villes, legende } = Astro.props;
const K = 10, kx = 78.2 * K, ky = 111.2 * K;
const siege = villes.find((v) => v.type === 'siege') ?? villes[0];
const lon0 = Math.min(...villes.map((v) => v.longitude)) - 0.077;
const lat0 = Math.max(...villes.map((v) => v.latitude)) + 0.037;
const X = (l: number) => (l - lon0) * kx;
const Y = (l: number) => (lat0 - l) * ky;
const W = Math.max(...villes.map((v) => X(v.longitude))) + 59;
const H = Math.max(...villes.map((v) => Y(v.latitude))) + 44;
const hx = X(siege.longitude), hy = Y(siege.latitude);
const suffixe = { siege: ' · Siège', etablissement: ' · Établissement', chantier: '' };
---

<svg viewBox={`-10 -10 ${W + 70} ${H + 20}`} role="img" aria-label={`Carte schématique des communes d'intervention autour de ${siege.nom}`}>
  {[10, 20].map((r) => (<><circle class="ring" cx={hx} cy={hy} r={r * K} /><text x={hx + 4} y={hy + r * K - 4} opacity=".45">{r} km</text></>))}
  {villes.filter((v) => v !== siege).map((v) => <line class="lnk" x1={hx} y1={hy} x2={X(v.longitude)} y2={Y(v.latitude)} />)}
  {villes.map((v) => {
    const x = X(v.longitude), y = Y(v.latitude), d = !v.etiquetteAGauche;
    return (
      <>
        {v.type === 'siege' ? <rect class="hq" x={x - 5} y={y - 5} width="10" height="10" /> : <circle class="pt" cx={x} cy={y} r={v.type === 'etablissement' ? 5 : 3.5} />}
        <text x={x + (d ? 10 : -10)} y={y + 3.5} text-anchor={d ? undefined : 'end'} font-weight={v.type === 'siege' ? 700 : undefined}>{v.nom}{suffixe[v.type]}</text>
      </>
    );
  })}
  <path d="M6 24v-14M6 10l-4 7M6 10l4 7" stroke="#000000" fill="none"></path>
  <text x="16" y="22">N</text>
  <text x="0" y={H - 4} opacity=".5">{legende}</text>
</svg>
