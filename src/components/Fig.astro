---
import { Image } from 'astro:assets';
import { image } from '../lib/images';
interface Props { src: string; alt: string; legende?: string; class?: string; i?: number; eager?: boolean; largeur?: number }
const { src, alt, legende = '', class: cls = '', i = 0, eager = false, largeur = 1600 } = Astro.props;
const meta = image(src);
---

<div class:list={['fig', cls]} data-r style={i ? `--i:${i}` : undefined}>
  <Image src={meta} alt={alt} width={Math.min(largeur, meta.width)} format="webp" loading={eager ? 'eager' : 'lazy'} />
  {legende && <div class="cap mono">{legende}</div>}
</div>
